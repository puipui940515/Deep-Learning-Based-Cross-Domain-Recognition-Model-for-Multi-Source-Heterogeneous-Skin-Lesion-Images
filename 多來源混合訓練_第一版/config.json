{
  "experiment_id": "mixed_source_ham_bcn_pilot_v1",
  "research_question": "加入 BCN20000 後，是否改善 HAM10000 以外的泛化能力",
  "model": "convnext_tiny",
  "initialization": "imagenet",
  "num_classes": 7,
  "class_names": ["AKIEC", "BCC", "BKL", "DF", "NV", "VASC", "MEL"],
  "image_size": 224,
  "batch_size": 16,
  "gradient_accumulation": 2,
  "epochs": 8,
  "early_stopping_patience": 4,
  "learning_rate": 0.0003,
  "weight_decay": 0.0001,
  "layer_decay": 0.7,
  "num_workers": 0,
  "seed": 17,
  "sampling": {
    "method": "source_balanced_class_smoothed_weighted_sampler",
    "class_balance_alpha": 0.5,
    "samples_per_epoch": "manifest_train_size"
  },
  "selection_metric": "mean_of_HAM10000_and_BCN20000_validation_balanced_accuracy",
  "manifest": "data/mixed_manifest.csv",
  "sources": {
    "HAM10000": {
      "split_manifest": "../第二階段/data/fixed_split.csv",
      "license": "CC BY-NC 4.0",
      "test_policy": "sealed_not_used"
    },
    "BCN20000": {
      "metadata": "../Dataset/BCN20000/metadata/available_train.csv",
      "split_profile": "../部位預測階段/data/profiles/bcn.csv",
      "license": "CC BY 4.0",
      "excluded_diagnoses": ["SCC"],
      "test_policy": "official_unlabeled_test_not_used"
    }
  },
  "test_used": false
}
